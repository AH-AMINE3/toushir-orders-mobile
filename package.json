{
  "name": "@toushir/orders-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8084",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "check:expo": "expo install --check",
    "merchant": "EXPO_PUBLIC_APP_ROLE=MERCHANT expo start",
    "driver": "EXPO_PUBLIC_APP_ROLE=DRIVER expo start",
    "build:merchant:android": "bash scripts/build-native.sh merchant android",
    "build:driver:android": "bash scripts/build-native.sh driver android",
    "preview:web": "python3 scripts/serve-preview.py --port 8086"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@microsoft/signalr": "^10.0.11",
    "expo": "~58.0.13",
    "expo-auth-session": "~58.0.13",
    "expo-camera": "~58.0.10",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.8",
    "expo-image": "~58.0.15",
    "expo-location": "~58.0.17",
    "expo-secure-store": "~58.0.2",
    "expo-web-browser": "~58.0.6",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^7.0.2"
  }
}
